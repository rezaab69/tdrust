# Copy this file to examples/sample-app/.env and fill in your values.
# examples/sample-app/.env is ignored by git; never commit real credentials.

# From https://my.telegram.org > API development tools
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# From @BotFather in Telegram (only needed for `bot` mode)
TELEGRAM_BOT_TOKEN=123456789:AAAbbbCCCdddEEEfffGGGhhhIIIjjjKKKll

# Full path of the TDLib library file. `~/` is expanded.
TDJSON_PATH=~/tdjson/x/tdjson.libs/libtdjson-41165018.so.1.8.67

# Optional: where sessions are stored (default: ~/.tdrust-sample)
# DATA_DIR=~/.tdrust-sample

# Optional: log level (error, warn, info, debug)
# RUST_LOG=info
