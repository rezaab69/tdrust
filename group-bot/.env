# Copy to .env and fill in. Never commit .env.

# From https://my.telegram.org (required even for bots)
TELEGRAM_API_ID=1238562
TELEGRAM_API_HASH=865335436178523ff7894d28e8bc86c1
# From @BotFather
TELEGRAM_BOT_TOKEN=8553201482:AAGfCRzEcakHEW9Xt9RdC9j7AnGKXhJHJ2o
# Full path to the TDLib library (libtdjson.so / tdjson.dll / libtdjson.dylib)
TDJSON_PATH=~/tdjson/libtdjson.so

DATABASE_URL=postgres://bot:bot@localhost:5432/groupbot
DATABASE_MAX_CONNECTIONS=10
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=gb:

# Comma-separated Telegram user ids with full control in every group
BOT_SUDO_IDS=128120622
# Language for new groups (fa, en, or any file in LOCALES_DIR)
DEFAULT_LANG=fa
# Optional directory with extra <code>.json translation files
# LOCALES_DIR=/path/to/locales
# TDLib session directory (keep it on a native Linux file system under WSL)
TDLIB_DATA_DIR=tdlib-group-bot
RUST_LOG=info
