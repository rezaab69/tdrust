# Copy to .env and fill in. Never commit .env.

# From https://my.telegram.org (required even for bots)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# From @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAAbbbCCC...
# Full path to the TDLib library (libtdjson.so / tdjson.dll / libtdjson.dylib)
TDJSON_PATH=/home/me/tdjson/libtdjson.so

DATABASE_URL=postgres://bot:bot@localhost:5432/groupbot
DATABASE_MAX_CONNECTIONS=10
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=gb:

# The bot's creators (comma-separated Telegram user ids): full control in every
# group, and the operator panel (/admin in a private chat with the bot)
BOT_SUDO_IDS=
# Backups and broadcast media; bots on one machine should share this directory
DATA_DIR=group-bot-data
# Language for new groups (fa, en, or any file in LOCALES_DIR)
DEFAULT_LANG=fa
# Optional directory with extra <code>.json translation files
# LOCALES_DIR=/path/to/locales
# TDLib session directory (keep it on a native Linux file system under WSL)
TDLIB_DATA_DIR=tdlib-group-bot
RUST_LOG=info
